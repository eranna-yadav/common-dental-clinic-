# ─── Site ─────────────────────────────────────────────────────────────
# Public production URL (no trailing slash). Used for canonical URLs, sitemap, OG & JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.your-clinic-domain.in

# ─── Email (appointment / contact / newsletter forms) ─────────────────
# Free Resend account: https://resend.com → API Keys.
# Without a key, form submissions are logged to the server console instead of emailed
# (patients still see the WhatsApp fallback).
RESEND_API_KEY=
# Inbox(es) that receive bookings & enquiries (comma-separated)
CLINIC_INBOX_EMAIL=reception@your-clinic-domain.in
# Verified sender. Until you verify a domain in Resend, use: Clinic <onboarding@resend.dev>
EMAIL_FROM=Clinic Website <bookings@your-clinic-domain.in>
# Optional: Resend Audience ID — newsletter sign-ups are added to this audience
RESEND_AUDIENCE_ID=

# ─── Analytics ────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=
# Vercel Web Analytics needs no variable — enable it in the Vercel dashboard.
